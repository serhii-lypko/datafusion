# Spark `regexp_extract(str, regexp[, idx])`.
# Semantics verified against Spark; see the module docs for known mismatches.
# Cases mirror playground/spark-oracle/regexp_extract_oracle.py.

## --- Scalar inputs ---

query T
SELECT regexp_extract('100-200', '(\d+)-(\d+)', 1);
----
100

query T
SELECT regexp_extract('100-200', '(\d+)-(\d+)', 2);
----
200

# idx = 0 -> whole match
query T
SELECT regexp_extract('100-200', '(\d+)-(\d+)', 0);
----
100-200

# idx omitted -> defaults to 1
query T
SELECT regexp_extract('100-200', '(\d+)-(\d+)');
----
100

# no match -> empty string (NOT null)
query T
SELECT regexp_extract('abc', '(\d+)', 1);
----
(empty)

# match, but optional group did not participate -> empty string
query T
SELECT regexp_extract('abc', '(a)(x)?', 2);
----
(empty)

# null subject -> null
query T
SELECT regexp_extract(NULL, '(\d+)', 1);
----
NULL

## --- Array inputs ---

query T
SELECT regexp_extract(s, '([a-z]+)(\d+)', 2)
FROM (VALUES ('a1'), ('bb22'), (NULL)) t(s);
----
1
22
NULL

## --- Errors ---

# idx out of range -> error
query error invalid group index
SELECT regexp_extract('100-200', '(\d+)-(\d+)', 5);

# negative idx (with a match) -> error
query error invalid group index
SELECT regexp_extract('abc', '(a)', -1);

# unsupported pattern (backreference; Spark/Java would match) -> compile error
query error failed to compile pattern
SELECT regexp_extract('aa', '(a)\1', 1);
